<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>AutoWhisper</string>
    <key>CFBundleDisplayName</key>
    <string>AutoWhisper</string>
    <key>CFBundleIdentifier</key>
    <string>us.primemanifold.autowhisper</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>autowhisper</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>LSMinimumSystemVersion</key>
    <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
    <!-- Dock / Finder / settings-window app icon (Contents/Resources/AppIcon.icns). -->
    <key>CFBundleIconFile</key>
    <string>AppIcon.icns</string>
    <!-- Menu-bar app: no Dock icon, no menu-bar app name. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Usage descriptions for TCC prompts. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>AutoWhisper uses your microphone to transcribe speech locally. Audio never leaves this device.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>AutoWhisper may use Apple Events to open settings, logs, or hand off text safely when macOS requires explicit permission.</string>
    <!-- The settings window is a WKWebView loading the local settings server
         over http://127.0.0.1; allow local networking so ATS does not block it. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
