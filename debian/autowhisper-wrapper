#!/bin/bash
# AutoWhisper CLI wrapper - triggers lazy venv setup on first run

VENV_DIR="/opt/autowhisper/venv"
MARKER_FILE="$VENV_DIR/.setup-complete"
SETUP_SCRIPT="/usr/share/autowhisper/autowhisper-setup"

# Check if setup is complete
if [ ! -f "$MARKER_FILE" ]; then
    # Run setup
    if [ -x "$SETUP_SCRIPT" ]; then
        "$SETUP_SCRIPT"
        if [ $? -ne 0 ]; then
            echo "Error: Failed to set up AutoWhisper environment" >&2
            exit 1
        fi
    else
        echo "Error: Setup script not found at $SETUP_SCRIPT" >&2
        exit 1
    fi
fi

# Execute the real autowhisper CLI
exec "$VENV_DIR/bin/autowhisper" "$@"
