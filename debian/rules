#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = autowhisper

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Skip tests during package build
	true

override_dh_auto_install:
	dh_auto_install

	# Install systemd user service template
	install -D -m 644 autowhisper.service \
		$(CURDIR)/debian/autowhisper/usr/lib/systemd/user/autowhisper.service

	# Install default config
	install -D -m 644 config.toml \
		$(CURDIR)/debian/autowhisper/etc/autowhisper/config.toml

	# Install pinned requirements for reproducible installs
	install -D -m 644 requirements.lock \
		$(CURDIR)/debian/autowhisper/usr/share/autowhisper/requirements.lock

	# Copy the built wheel for venv installation
	install -D -m 644 $$(find .pybuild -name "autowhisper-*.whl" | head -1) \
		$(CURDIR)/debian/autowhisper/usr/share/autowhisper/autowhisper.whl

	# Install documentation
	install -D -m 644 README.md \
		$(CURDIR)/debian/autowhisper/usr/share/doc/autowhisper/README.md

override_dh_installsystemd:
	# Skip - we use a user service, not a system service
