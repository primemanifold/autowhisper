#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DAUTOWHISPER_ENABLE_TESTS=OFF

override_dh_auto_test:
	# Skip tests during package build
	true

override_dh_auto_install:
	dh_auto_install

	# Install systemd user service
	install -D -m 644 autowhisper.service \
		$(CURDIR)/debian/autowhisper/usr/lib/systemd/user/autowhisper.service

	# Install default config
	install -D -m 644 config.toml \
		$(CURDIR)/debian/autowhisper/etc/autowhisper/config.toml

	# Install documentation
	install -D -m 644 README.md \
		$(CURDIR)/debian/autowhisper/usr/share/doc/autowhisper/README.md

override_dh_installsystemd:
	# Skip - we use a user service, not a system service
