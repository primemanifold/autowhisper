#!/bin/bash
set -e

case "$1" in
    configure)
        # Create models directory if it doesn't exist
        mkdir -p /usr/share/autowhisper/models

        echo ""
        echo "================================================================"
        echo "AutoWhisper installed!"
        echo "================================================================"
        echo ""
        echo "Quick start:"
        echo "  1. Check system:   autowhisper doctor"
        echo "  2. Enable service: systemctl --user enable --now autowhisper"
        echo "  3. Test hotkey:    Press Ctrl+Shift+Space and speak"
        echo ""
        echo "Configuration: ~/.config/autowhisper/config.toml"
        echo "               /etc/autowhisper/config.toml (system default)"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
