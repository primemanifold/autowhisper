#!/bin/bash
set -e

VENV_DIR="/opt/autowhisper/venv"
SHARE_DIR="/usr/share/autowhisper"

# Detect GPU architecture to choose correct PyTorch index
detect_pytorch_index() {
    # Try to detect NVIDIA GPU
    if command -v nvidia-smi &> /dev/null; then
        GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)

        # RTX 50xx series (Blackwell) needs nightly with CUDA 12.8
        if echo "$GPU_NAME" | grep -qiE "RTX 50[0-9][0-9]|Blackwell"; then
            echo "https://download.pytorch.org/whl/nightly/cu128"
            return
        fi
    fi

    # Default to stable CUDA 12.4 for older GPUs
    echo "https://download.pytorch.org/whl/cu124"
}

case "$1" in
    configure)
        # Create models directory if it doesn't exist
        mkdir -p /usr/share/autowhisper/models

        # Check if whisper.cpp is available
        if command -v whisper-cli &> /dev/null; then
            echo "whisper.cpp detected"
        fi

        echo ""
        echo "================================================================"
        echo "AutoWhisper: Setting up isolated Python environment..."
        echo "================================================================"
        echo ""

        # Create virtual environment
        if [ ! -d "$VENV_DIR" ]; then
            echo "Creating virtual environment at $VENV_DIR..."
            python3 -m venv "$VENV_DIR"
        fi

        # Upgrade pip in venv
        echo "Upgrading pip..."
        "$VENV_DIR/bin/pip" install --upgrade pip --quiet

        # Detect correct PyTorch index URL
        PYTORCH_INDEX=$(detect_pytorch_index)
        echo "Using PyTorch index: $PYTORCH_INDEX"

        # Install dependencies and autowhisper wheel
        echo "Installing dependencies (this may take a few minutes)..."
        "$VENV_DIR/bin/pip" install \
            --extra-index-url "$PYTORCH_INDEX" \
            -r "$SHARE_DIR/requirements.lock" \
            "$SHARE_DIR/autowhisper.whl" \
            --quiet

        # Create symlink for easy CLI access
        ln -sf "$VENV_DIR/bin/autowhisper" /usr/local/bin/autowhisper 2>/dev/null || true

        echo ""
        echo "================================================================"
        echo "AutoWhisper installed successfully!"
        echo "================================================================"
        echo ""
        echo "Quick start:"
        echo "  1. Check system:   autowhisper doctor"
        echo "  2. Enable service: systemctl --user enable --now autowhisper"
        echo "  3. Test hotkey:    Press Ctrl+Shift+Space and speak"
        echo ""
        echo "Note: Models are downloaded automatically on first use."
        echo ""
        echo "Configuration: ~/.config/autowhisper/config.toml"
        echo "               /etc/autowhisper/config.toml (system default)"
        echo ""
        echo "View logs: journalctl --user -u autowhisper -f"
        echo ""
        echo "Virtual environment: $VENV_DIR"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
