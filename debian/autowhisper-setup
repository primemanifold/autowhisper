#!/bin/bash
# AutoWhisper venv setup script - uses uv for fast installation
set -e

VENV_DIR="/opt/autowhisper/venv"
SHARE_DIR="/usr/share/autowhisper"
MARKER_FILE="$VENV_DIR/.setup-complete"

# Detect GPU architecture to choose correct PyTorch index
detect_pytorch_index() {
    if command -v nvidia-smi &> /dev/null; then
        GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
        # RTX 50xx series (Blackwell) needs nightly with CUDA 12.8
        if echo "$GPU_NAME" | grep -qiE "RTX 50[0-9][0-9]|Blackwell"; then
            echo "https://download.pytorch.org/whl/nightly/cu128"
            return
        fi
    fi
    # Default to stable CUDA 12.4 for older GPUs
    echo "https://download.pytorch.org/whl/cu124"
}

# Check if already set up
if [ -f "$MARKER_FILE" ]; then
    echo "AutoWhisper environment already configured."
    exit 0
fi

echo ""
echo "================================================================"
echo "AutoWhisper: Setting up Python environment (first run)..."
echo "================================================================"
echo ""

# Create venv directory (requires root)
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment..."
    sudo mkdir -p "$VENV_DIR"
    sudo chown "$USER:$USER" "$VENV_DIR"
    python3 -m venv "$VENV_DIR"
fi

# Ensure we own the venv
if [ ! -w "$VENV_DIR" ]; then
    sudo chown -R "$USER:$USER" "$VENV_DIR"
fi

# Install uv for fast dependency installation
echo "Installing uv package manager..."
"$VENV_DIR/bin/pip" install uv --quiet

# Detect correct PyTorch index URL
PYTORCH_INDEX=$(detect_pytorch_index)
echo "Using PyTorch index: $PYTORCH_INDEX"

# Find the wheel file
WHEEL_FILE=$(find "$SHARE_DIR" -name "autowhisper-*.whl" | head -1)
if [ -z "$WHEEL_FILE" ]; then
    echo "Error: Could not find autowhisper wheel in $SHARE_DIR" >&2
    exit 1
fi

# Install dependencies with uv (much faster than pip)
echo "Installing dependencies with uv..."
UV_HTTP_TIMEOUT=300 "$VENV_DIR/bin/uv" pip install \
    --python "$VENV_DIR/bin/python" \
    --extra-index-url "$PYTORCH_INDEX" \
    --index-strategy unsafe-best-match \
    -r "$SHARE_DIR/requirements.lock" \
    "$WHEEL_FILE"

# Create marker file
touch "$MARKER_FILE"

echo ""
echo "================================================================"
echo "AutoWhisper environment ready!"
echo "================================================================"
echo ""
