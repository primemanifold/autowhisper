function renderField(panel, section, f) {
  const id = section + '.' + f.k;
  let html = '';
  if (f.t === 'check') {
    html = '<div class="check-field"><label><input type="checkbox" id="'+id+'"> '+f.l+'</label></div>';
  } else if (f.t === 'select') {
    const opts = OPTIONS[f.o].map(o => '<option value="'+o+'">'+o+'</option>').join('');
    html = '<div class="field"><label>'+f.l+'</label><select id="'+id+'">'+opts+'</select></div>';
  } else if (f.t === 'num') {
    const a = [];
    if (f.min != null) a.push('min="'+f.min+'"');
    if (f.max != null) a.push('max="'+f.max+'"');
    if (f.step != null) a.push('step="'+f.step+'"');
    html = '<div class="field"><label>'+f.l+'</label><input type="number" id="'+id+'" '+a.join(' ')+'></div>';
  } else {
    html = '<div class="field"><label>'+f.l+'</label><input type="text" id="'+id+'"></div>';
  }
  if (f.h) html += '<div class="hint">'+f.h+'</div>';
  panel.insertAdjacentHTML('beforeend', html);
