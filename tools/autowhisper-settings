# ── Config I/O ───────────────────────────────────────────────────────

def find_config() -> Path:
    for p in [
        Path.home() / ".config" / "autowhisper" / "config.toml",
        Path("/etc/autowhisper/config.toml"),
        Path("/opt/autowhisper/config.toml"),
    ]:
        if p.is_file():
            return p
    return Path.home() / ".config" / "autowhisper" / "config.toml"


def load_config(path: Path) -> dict:
    config = {s: dict(v) for s, v in DEFAULTS.items()}
    if path.is_file():
        with open(path, "rb") as f:
            data = tomllib.load(f)
        for section in config:
            if section in data:
                for key in config[section]:
                    if key in data[section]:
                        config[section][key] = data[section][key]
    return config


def coerce_types(config: dict) -> dict:
    """Ensure values match the expected types from DEFAULTS."""
    for section in DEFAULTS:
        if section not in config:
            continue
        for key, default in DEFAULTS[section].items():
            if key not in config[section]:
                continue
            val = config[section][key]
            if isinstance(default, float) and isinstance(val, int):
                config[section][key] = float(val)
            elif isinstance(default, int) and isinstance(val, float):
                config[section][key] = int(val)
    return config


def fmt_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        s = f"{v:.10g}"
        return s if "." in s else s + ".0"
    if isinstance(v, str):
        return f"'{v}'"
    if isinstance(v, list):
        return "[ " + ", ".join(f"'{x}'" for x in v) + " ]"
    return repr(v)


COMMENTS = {
    ("daemon", "log_level"): "# log_level: trace, debug, info, warn, error, critical, off",
    ("hotkeys", "mode"): "# mode: push_to_talk, toggle",
    ("model", "compute_type"): "# compute_type: float16, float32, int8, int8_float16, int8_float32, int8_bfloat16, bfloat16",
    ("model", "device"): "# device: cuda, cpu, auto",
    ("model", "size"): (
        "# size: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en,\n"
        "#       large, large-v1, large-v2, large-v3,\n"
        "#       distil-large-v2, distil-large-v3, distil-medium.en, distil-small.en"
    ),
    ("output", "ending_action"): "# ending_action: none, newline, return_key",
    ("output", "method"): "# method: inject, clipboard",
}


def save_config(path: Path, config: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = []
    for i, section in enumerate(["audio", "daemon", "feedback", "hotkeys", "model", "output", "tray"]):
        if section not in config:
            continue
        if i > 0:
            lines.append("")
        lines.append(f"[{section}]")
        for key in sorted(config[section]):
            c = COMMENTS.get((section, key))
            if c:
                lines.append(c)
            lines.append(f"{key} = {fmt_value(config[section][key])}")
    lines.append("")
    path.write_text("\n".join(lines))


