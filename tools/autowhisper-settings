# ── HTTP Server ──────────────────────────────────────────────────────

class SettingsServer(http.server.HTTPServer):
    def __init__(self, config_path: Path, config: dict):
        self.config_path = config_path
        self.config = config
        super().__init__(("127.0.0.1", 0), SettingsHandler)


class SettingsHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/":
            self._serve_html()
        elif self.path == "/quit":
            self._text_response("bye")
            threading.Thread(target=self.server.shutdown).start()
        else:
            self.send_error(404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = json.loads(self.rfile.read(length))
        config = coerce_types(body)

        if self.path == "/save":
            self._handle_save(config)
        elif self.path == "/save-and-restart":
            self._handle_save_and_restart(config)
        else:
            self.send_error(404)

    def _serve_html(self):
        srv = self.server
        safe = lambda d: json.dumps(d).replace("</", "<\\/")
        html = (
            HTML.replace("__CONFIG__", safe(srv.config))
            .replace("__DEFAULTS__", safe(DEFAULTS))
            .replace("__OPTIONS__", safe(OPTIONS))
            .replace("__PATH__", str(srv.config_path))
        )
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(html.encode())

    def _handle_save(self, config):
        try:
            save_config(self.server.config_path, config)
            self.server.config = config
            self._json_response({"ok": True, "message": "Settings saved."})
        except Exception as e:
            self._json_response({"ok": False, "message": str(e)})

    def _handle_save_and_restart(self, config):
        try:
            save_config(self.server.config_path, config)
            self.server.config = config
        except Exception as e:
            self._json_response({"ok": False, "message": str(e)})
            return

        try:
            result = subprocess.run(
                ["systemctl", "--user", "restart", "autowhisper"],
                capture_output=True, text=True, timeout=10,
            )
            if result.returncode == 0:
                self._json_response({"ok": True, "message": "Settings saved and service restarted."})
            else:
                self._json_response({
                    "ok": False,
                    "message": f"Saved, but restart failed: {result.stderr.strip()}",
                })
        except FileNotFoundError:
            self._json_response({
                "ok": True,
                "message": "Settings saved. Restart the service manually (systemctl not found).",
            })
        except subprocess.TimeoutExpired:
            self._json_response({"ok": False, "message": "Saved, but restart timed out."})

    def _json_response(self, data):
        body = json.dumps(data).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _text_response(self, text):
        body = text.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass


# ── Entry point ──────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="AutoWhisper Settings Editor")
    parser.add_argument("-c", "--config", help="Config file path")
    args = parser.parse_args()

    config_path = Path(args.config) if args.config else find_config()
    config = load_config(config_path)

    server = SettingsServer(config_path, config)
    port = server.server_address[1]
    url = f"http://127.0.0.1:{port}"

    print(f"AutoWhisper Settings: {url}")
    print("Press Ctrl+C to close")

    webbrowser.open(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down.")
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
