      if (el.type === 'checkbox') el.checked = val;
      else if (Array.isArray(val)) el.value = val.join(', ');
      else el.value = val;
    }
  }
}

function collect() {
  const cfg = {};
  for (const [section, defs] of Object.entries(DEFAULTS)) {
    cfg[section] = {};
    for (const [key, def] of Object.entries(defs)) {
      const el = document.getElementById(section+'.'+key);
      if (!el) { cfg[section][key] = def; continue; }
      if (typeof def === 'boolean') cfg[section][key] = el.checked;
      else if (Array.isArray(def)) cfg[section][key] = el.value.split(',').map(s=>s.trim()).filter(Boolean);
      else if (Number.isInteger(def)) cfg[section][key] = parseInt(el.value) || def;
      else if (typeof def === 'number') cfg[section][key] = parseFloat(el.value) || def;
      else cfg[section][key] = el.value;
    }
  }
  return cfg;
}

