# AutoWhisper User Service
# This is a systemd USER service that runs within your graphical session.
# Install to: ~/.config/systemd/user/autowhisper.service
#
# Start:   systemctl --user start autowhisper
# Enable:  systemctl --user enable autowhisper
# Logs:    journalctl --user -u autowhisper -f

[Unit]
Description=AutoWhisper GPU-Accelerated Voice-to-Text
Documentation=https://github.com/autowhisper/autowhisper
# Only start after graphical session is ready
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple

# Run the native binary
# Note: DISPLAY, XAUTHORITY, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS
# are inherited from the user's graphical session automatically
ExecStart=/usr/local/bin/autowhisper run

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=2G
CPUQuota=400%

[Install]
WantedBy=graphical-session.target
